# /etc/mcfrs-scanner/audio.env — per-box audio config for mcfrs-audio.service.
# Copy to the box and fill in; the real file is never committed (same rule as the
# I-Gate's igate.conf). Authority for the pipeline: docs/AUDIO.md.

# Icecast source password. Must match <source-password> in /etc/icecast2/icecast.xml
# (bin/install-on-box.sh writes both from this value).
ICECAST_PW=change-me
ICECAST_PORT=8000
ICECAST_MOUNT=mcfrs.mp3

# ALSA output for the 3.5 mm AUX path (USB audio adapter). Empty = Icecast only.
# Find the name with:  aplay -L   (e.g. plughw:CARD=Device,DEV=0)
ALSA_DEV=

# OP25's UDP audio port (rx.py -u / audio.py -u). Loopback only.
OP25_AUDIO_PORT=23456
