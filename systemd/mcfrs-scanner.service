[Unit]
Description=MCFRS P25 scanner (OP25 rx.py, single RTL-SDR)
After=network-online.target
Wants=network-online.target
# The dongle has one owner. Starting this unit stops the I-Gate; the I-Gate unit
# carries the reciprocal Conflicts= (cross-repo change, aprs-igate/systemd/).
Conflicts=aprs-igate.service
# Audio pipeline follows this unit (BindsTo= on its side, Wants= here).
Wants=mcfrs-audio.service

[Service]
# Flags verified against rx.py on the box 2026-09-02 (boatbod gr310 @ 5b58335):
#   -2  Phase II TDMA voice            -n  silence encrypted traffic (never decoded)
#   -T  trunk definition               -V  verbose trunking log (journal)
#   -w -W 127.0.0.1 -u PORT  decoded audio as PCM over UDP, loopback only -> mcfrs-audio
#   -l http:0.0.0.0:8080  OP25 web terminal, LAN only (what is being heard, right now)
#   -N 'LNA:49'  starting gain = the I-Gate's measured 49.6 dB (its unit file); tune in phase 2
#   -S 2400000 -o 25000 -q 0  rtl sample rate, DC-offset tune, ppm (V4 has a TCXO)
WorkingDirectory=/home/rocketman/op25/op25/gr-op25_repeater/apps
ExecStart=/usr/bin/python3 rx.py --args rtl -N 'LNA:49' -S 2400000 -o 25000 -q 0 -2 -n -V -w -W 127.0.0.1 -u 23456 -T /etc/mcfrs-scanner/mcfrs-trunk.tsv -l http:0.0.0.0:8080
Restart=on-failure
RestartSec=5
User=rocketman

[Install]
WantedBy=multi-user.target
